{
  "expo": {
    "name": "ParkCast: Car Video & Mirror",
    "slug": "parkcast",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6FB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkcast.carvideo",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "ParkCast needs access to your photos and videos so you can display them on your car screen while parked.",
        "NSLocalNetworkUsageDescription": "ParkCast uses your local network to connect and stream media to your car display and AirPlay receivers.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.parkcast.carvideo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F6FB"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
