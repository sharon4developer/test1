{
  "expo": {
    "name": "ParkCast: Car Video & Mirror",
    "slug": "parkcast",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkcast.carvideo.test",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "ParkCast shows the photos and videos you pick on your car screen.",
        "NSLocationWhenInUseUsageDescription": "ParkCast uses your location to show where you are on the car map, give turn-by-turn directions, show your speed and pause video while the car is moving.",
        "NSMicrophoneUsageDescription": "ParkCast listens only while you hold the microphone button so you can say where to go or what to play.",
        "NSSpeechRecognitionUsageDescription": "ParkCast turns your spoken request into an action, on your iPhone whenever possible.",
        "UIBackgroundModes": [
          "audio",
          "location"
        ]
      }
    },
    "plugins": [
      "./plugins/withParkCastCarPlay",
      "./plugins/withParkCastBroadcast",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParkCast uses your location to show where you are on the car map, give turn-by-turn directions, show your speed and pause video while the car is moving."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458507531",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This lets ParkCast show ads that are more relevant to you. Premium removes all ads."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets ParkCast show ads that are more relevant to you. Premium removes all ads."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#F7F8FB",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "android": {
      "package": "com.parkcast.carvideo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F8FB"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "owner": "dotnot",
    "extra": {
      "relayUrl": "https://parkcast-x9nd.onrender.com",
      "supportEmail": "support@parkcast.app",
      "weatherApiUrl": "https://api.open-meteo.com/v1/forecast",
      "mirrorPort": 48231,
      "revenueCatIosKey": "",
      "ads": {
        "enabled": true,
        "useTestIds": true,
        "iosBannerUnitId": "",
        "iosRewardedUnitId": "",
        "iosInterstitialUnitId": ""
      },
      "eas": {
        "projectId": "427b8aaf-76c8-4a7e-847b-b5cabc0444aa",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ParkCastBroadcast",
                  "bundleIdentifier": "com.parkcast.carvideo.test.broadcast",
                  "entitlements": {}
                }
              ]
            }
          }
        }
      }
    }
  }
}
